// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int          @id @default(autoincrement())
  email       String       @unique
  password    String
  name        String?
  avatar      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  connections Connection[]
  canvases    Canvas[]
  savedViews  SavedView[]
  projects    Project[]

  tableRelationships TableRelationship[]
  patternRules       PatternRule[]
  deepQueries        DeepQuery[]
}

model Project {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  ownerId     Int
  owner       User         @relation(fields: [ownerId], references: [id])

  connections Connection[]
  canvases    Canvas[]
  savedViews  SavedView[]
}

model SavedView {
  id          Int      @id @default(autoincrement())
  name        String
  config      Json
  result      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projectId   Int?
  project     Project? @relation(fields: [projectId], references: [id])

  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id])
}

model Connection {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   // pg, mysql2, etc.
  host      String
  port      Int
  user      String   // DB username
  password  String   // DB password
  database  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id])

  canvases  Canvas[]
  
  ownerId   Int?
  owner     User?    @relation(fields: [ownerId], references: [id])

  tableRelationships TableRelationship[]
  patternRules       PatternRule[]
  deepQueries        DeepQuery[]
  queryCaches        QueryCache[]
  columnProfiles     ColumnProfile[]
}

model Canvas {
  id           Int         @id @default(autoincrement())
  name         String
  data         Json
  
  connectionId Int?
  connection   Connection? @relation(fields: [connectionId], references: [id])
  
  projectId    Int?
  project      Project?    @relation(fields: [projectId], references: [id])

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  ownerId      Int?
  owner        User?       @relation(fields: [ownerId], references: [id])

  versions     CanvasVersion[]
}

model CanvasVersion {
  id        Int      @id @default(autoincrement())
  name      String
  data      Json
  createdAt DateTime @default(now())
  
  canvasId  Int
  canvas    Canvas   @relation(fields: [canvasId], references: [id])
}

model TableRelationship {
  id          Int     @id @default(autoincrement())
  name        String?
  description String?

  sourceTable      String
  sourceColumn     String
  targetTable      String
  targetColumn     String
  relationshipType TableRelationshipType

  detectionMethod DetectionMethod
  confidence      Float?          @default(1.0)
  constraintName  String?

  connectionId Int
  connection   Connection @relation(fields: [connectionId], references: [id])

  isActive  Boolean  @default(true)
  isCustom  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patternRuleId Int?
  patternRule   PatternRule? @relation(fields: [patternRuleId], references: [id])

  ownerId Int?
  owner   User? @relation(fields: [ownerId], references: [id])

  @@unique([connectionId, sourceTable, sourceColumn, targetTable, targetColumn])
  @@index([connectionId, sourceTable, targetTable])
}

model PatternRule {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  sourcePattern    String
  targetPattern    String
  relationshipType TableRelationshipType
  priority         Int                   @default(0)

  isEnabled     Boolean @default(true)
  minConfidence Float?  @default(0.7)

  connectionId Int?
  connection   Connection? @relation(fields: [connectionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tableRelationships TableRelationship[]

  ownerId Int?
  owner   User? @relation(fields: [ownerId], references: [id])

  @@index([connectionId, priority])
}

model DeepQuery {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  startTable     String
  startCondition Json?
  maxDepth       Int    @default(5)
  includeFields  Json?
  excludeFields  Json?

  connectionId Int
  connection   Connection @relation(fields: [connectionId], references: [id])

  useCache      Boolean @default(true)
  cacheDuration Int?    @default(300)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastResult     Json?
  lastExecutedAt DateTime?
  executionTime  Int?

  ownerId Int?
  owner   User? @relation(fields: [ownerId], references: [id])

  @@index([connectionId, startTable])
}

model QueryCache {
  id        Int    @id @default(autoincrement())
  queryHash String @unique
  queryData Json
  result    Json

  connectionId Int
  connection   Connection @relation(fields: [connectionId], references: [id])

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([connectionId, expiresAt])
}

model ColumnProfile {
  id           Int        @id @default(autoincrement())
  connectionId Int
  connection   Connection @relation(fields: [connectionId], references: [id])
  tableName    String
  columnName   String

  sampleValues Json

  lastUpdated DateTime @default(now())

  @@unique([connectionId, tableName, columnName])
  @@index([connectionId, tableName])
}

enum TableRelationshipType {
  ONE_TO_ONE
  ONE_TO_MANY
  MANY_TO_ONE
  MANY_TO_MANY
}

enum DetectionMethod {
  FOREIGN_KEY
  NAMING_CONVENTION
  PATTERN_MATCHING
  MANUAL
  INFERRED
}
